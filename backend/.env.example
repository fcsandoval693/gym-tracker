# Copia este archivo como .env y rellena tus valores.
# .env NO se sube a GitHub; este archivo de ejemplo sí.

# Base de datos (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gym_tracker
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432

# Django
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo al publicar (en tu PC no hacen falta):
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/nombre
# CORS_ALLOWED_ORIGINS=https://tu-frontend.example.com
# CSRF_TRUSTED_ORIGINS=https://tu-backend.example.com
